    "option": [
      {
        "id": "roving",
        "widget": "tabs",
        "label": "Roving",
        "body": "One member of the group is in the page's tab sequence; the rest carry tabindex -1. Moving the tab stop moves DOM focus with it.",
        "open": "false",
        "pos": 1
      },
      {
        "id": "virtual",
        "widget": "tabs",
        "label": "Virtual",
        "body": "Focus never leaves the container. aria-activedescendant names the active row, and no element is ever focused but the container itself.",
        "open": "false",
        "pos": 2
      },
      {
        "id": "none",
        "widget": "tabs",
        "label": "Neither",
        "body": "Every member is in the tab sequence. Right for a small set of unrelated controls, wrong for a list, and the reason a list needs one of the two above.",
